# ==============================================================================
# ResumeCraft AI - Environment Configuration Example
# Copy this file to .env and configure your secret credentials.
# ==============================================================================

# Django Secret Key (Generate a random 50-character string for production)
SECRET_KEY=django-insecure-resumecraft-ai-super-secret-key-for-local-development

# Debug Mode (Set to False for production/Render deployment)
DEBUG=True

# Google Gemini API Key
# Obtain a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Supported Gemini Model (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Allowed Hosts (Comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,*

# CSRF Trusted Origins for Render Deployment (Comma-separated)
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,http://localhost:8000,http://127.0.0.1:8000
